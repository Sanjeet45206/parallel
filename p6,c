#include <stdio.h>
#include <mpi.h>
#define N 100000

int main(int argc, char *argv[]) {
    int rank;
    static int sendbuf[N], recvbuf[N];
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    int other = 1 - rank;               /* run with exactly 2 processes */
    for (int i = 0; i < N; i++) sendbuf[i] = rank;

    /* DEADLOCK: both send first, both wait for a receiver that never comes
    MPI_Send(sendbuf, N, MPI_INT, other, 0, MPI_COMM_WORLD);
    MPI_Recv(recvbuf, N, MPI_INT, other, 0, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    */

    /* AVOIDANCE: alter the call sequence */
    if (rank == 0) {
        MPI_Send(sendbuf, N, MPI_INT, 1, 0, MPI_COMM_WORLD);
        MPI_Recv(recvbuf, N, MPI_INT, 1, 0, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    } else {
        MPI_Recv(recvbuf, N, MPI_INT, 0, 0, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
        MPI_Send(sendbuf, N, MPI_INT, 0, 0, MPI_COMM_WORLD);
    }
    printf("Process %d received %d\n", rank, recvbuf[0]);
    MPI_Finalize();
    return 0;
}

